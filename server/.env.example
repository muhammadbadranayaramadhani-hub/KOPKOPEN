# Salin file ini menjadi .env, lalu isi GROQ_API_KEY.
# JANGAN commit file .env. Jangan bagikan API key.

# API key Groq
GROQ_API_KEY=

# Model Groq
GROQ_MODEL=openai/gpt-oss-20b

# Konfigurasi server
PORT=8787
HOST=127.0.0.1

# Batas waktu permintaan AI (milidetik)
AI_TIMEOUT_MS=25000

# Batas permintaan per IP per menit
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_HEAVY_PER_MIN=8

# Kosongkan jika memakai proxy Vite / satu origin
ALLOWED_ORIGINS=

# Isi 1 jika backend berada di belakang reverse proxy
TRUST_PROXY=0
