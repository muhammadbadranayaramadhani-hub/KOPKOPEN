{
  "name": "mysteria",
  "private": true,
  "version": "1.0.0",
  "description": "MYSTERIA: The Academy of Hidden Knowledge — game misteri edukasi untuk siswa SMP.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
