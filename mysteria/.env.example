# Salin file ini menjadi `.env` di folder server/, lalu isi GEMINI_API_KEY.
# JANGAN commit file .env. Kunci ini hanya dibaca oleh backend, tidak pernah dikirim ke browser.

# Kunci API dari Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini. Ganti jika model ini tidak tersedia untuk akunmu.
GEMINI_MODEL=gemini-3.6-flash

# Port & alamat backend. Bawaan 127.0.0.1 (hanya komputer ini); proxy Vite yang meneruskan /api.
PORT=8787
HOST=127.0.0.1

# Batas waktu satu panggilan Gemini (milidetik)
AI_TIMEOUT_MS=25000

# Batas permintaan per IP per menit (umum dan untuk endpoint berat: evaluate & generate-challenge)
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_HEAVY_PER_MIN=8

# Hanya perlu diisi jika frontend dan backend berbeda origin (mis. deployment terpisah).
# Pisahkan dengan koma. Kosongkan jika memakai proxy Vite / satu origin.
ALLOWED_ORIGINS=

# Isi 1 jika backend berada di belakang reverse proxy (agar rate limit memakai IP klien asli).
TRUST_PROXY=0
GEMINI_THINKING_LEVEL=

# Penyedia AI: gemini (bawaan) atau groq. Isi kunci HANYA untuk penyedia yang dipakai.
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
